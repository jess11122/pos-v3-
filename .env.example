# TabFlow Environment Variables
# Copy this to .env.local and fill in your Supabase values.
# NEVER commit .env.local to git — it is in .gitignore.

# Supabase — Project Settings → API
# The anon key is safe to expose in the frontend (RLS enforces access control).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# WARNING: Do NOT add SUPABASE_SERVICE_ROLE_KEY here.
# The service_role key bypasses all RLS and must only be used in
# Supabase Edge Functions (set via the Supabase dashboard secrets, not here).
